{
  "catalogVersion": "1.0",
  "programId": "gts-ai-sdlc",
  "limits": {
    "maxCatalogRepositories": 100,
    "maxActiveRepositories": 8,
    "maxParallelWorkers": 4,
    "maxPlanReviewCycles": 3,
    "maxRepairAttempts": 2
  },
  "repositories": [
    {
      "repositoryId": "gts-ai-sdlc",
      "displayName": "GTS AI SDLC",
      "system": "GTS-SDLC",
      "orchestrator": "repository-worker",
      "lifecycle": "ACTIVE",
      "owners": [
        "gts-sdlc-maintainers"
      ],
      "revision": "82977deceeb5c02f69988178ca93a70fd4e91b50",
      "checkout": {
        "mode": "existing-or-clone",
        "localCandidates": [
          "."
        ],
        "defaultBranch": "master"
      },
      "components": [
        "agent-framework",
        "skills",
        "multi-repository-orchestration"
      ],
      "paths": [
        ".github/**",
        ".agents/**",
        "README.md"
      ],
      "provides": [
        "gts-agent-orchestration"
      ],
      "consumes": [],
      "contractsProduced": [],
      "contractsConsumed": [],
      "dependencies": [],
      "gui": false,
      "customizations": {
        "instructions": [
          ".github/copilot-instructions.md"
        ],
        "agents": [
          ".github/agents"
        ],
        "skills": [
          ".agents/skills"
        ]
      },
      "commands": {
        "bootstrap": [],
        "unit": [],
        "integration": [],
        "lint": [],
        "build": [],
        "security": []
      }
    }
  ]
}
