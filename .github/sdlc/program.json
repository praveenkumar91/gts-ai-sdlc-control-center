{
  "schemaVersion": "2.0",
  "programId": "gts-ai-sdlc",
  "catalogGlobs": [
    ".github/sdlc/repositories.d/*.json"
  ],
  "workspaceSearchRoots": [
    ".",
    "workspace/repositories",
    ".."
  ],
  "worktreeRoot": "workspace/worktrees",
  "runRoot": ".github/sdlc-runs",
  "limits": {
    "maxCatalogRepositories": 100,
    "maxActiveRepositories": 12,
    "maxParallelWorkers": 4,
    "maxPlanReviewCycles": 3,
    "maxRepairAttempts": 2
  },
  "humanGates": {
    "beforeImplementation": true,
    "beforePrApprovalOrMerge": true
  }
}
