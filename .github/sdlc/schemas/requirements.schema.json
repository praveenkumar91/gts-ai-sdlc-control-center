{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/requirements.schema.json",
  "type": "object",
  "required": [
    "change_id",
    "source_set_digest",
    "source_set",
    "requirements"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "minLength": 3
    },
    "source_set_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "version",
          "content_sha256",
          "locator"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "statement",
          "type",
          "criticality",
          "sources",
          "repositories",
          "acceptance_criteria",
          "required_evidence",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_-]+-[0-9]{3,}$"
          },
          "statement": {
            "type": "string",
            "minLength": 10
          },
          "type": {
            "enum": [
              "functional",
              "non-functional",
              "security",
              "data",
              "operational",
              "migration",
              "regulatory",
              "derived"
            ]
          },
          "criticality": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "version",
                "section"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "section": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "repositories": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$"
            }
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "required": [
                    "id",
                    "statement"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Z][A-Z0-9_-]+-[0-9]{3,}$"
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gui_contract": {
            "type": "object",
            "required": [
              "affected_views",
              "user_journeys",
              "viewports",
              "states",
              "baseline_refs",
              "approval_ref"
            ],
            "properties": {
              "affected_views": {
                "$ref": "#/$defs/nonEmptyStringArray"
              },
              "user_journeys": {
                "$ref": "#/$defs/nonEmptyStringArray"
              },
              "viewports": {
                "$ref": "#/$defs/nonEmptyStringArray"
              },
              "states": {
                "$ref": "#/$defs/nonEmptyStringArray"
              },
              "baseline_refs": {
                "$ref": "#/$defs/nonEmptyStringArray"
              },
              "approval_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "scope",
                "gate_ids",
                "acceptance_criteria_ids",
                "evidence_types"
              ],
              "properties": {
                "scope": {
                  "enum": [
                    "repository",
                    "integration"
                  ]
                },
                "repository": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{1,62}$"
                },
                "gate_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
                  }
                },
                "acceptance_criteria_ids": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "evidence_types": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "scope": {
                        "const": "repository"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "repository"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "repository"
                      ]
                    }
                  }
                }
              ],
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "required_evidence": {
                  "contains": {
                    "const": "gui-validation"
                  }
                }
              },
              "required": [
                "required_evidence"
              ]
            },
            "then": {
              "required": [
                "gui_contract"
              ]
            }
          }
        ],
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
