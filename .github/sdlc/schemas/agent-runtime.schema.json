{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/agent-runtime.schema.json",
  "title": "Durable repository-agent execution runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adoption_complete",
    "worker"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "adoption_complete": {
      "type": "boolean"
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "mode",
        "working_directory",
        "timeout_seconds",
        "max_output_bytes",
        "max_prompt_bytes",
        "maximum_worker_attempts",
        "stale_lock_seconds",
        "blocked_spec_exit_code",
        "inconclusive_exit_code",
        "git_author_name",
        "git_author_email",
        "environment_allowlist",
        "protected_paths"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "command",
            "vscode-chat",
            "copilot-sdk"
          ]
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sdk_runner": {
          "type": "string",
          "minLength": 1
        },
        "sdk_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([A-Za-z0-9.-]+)?$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "required_specialist_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "honor_agent_models": {
          "type": "boolean"
        },
        "working_directory": {
          "enum": [
            "worktree",
            "control-plane"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 28800
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 52428800
        },
        "max_prompt_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1000000
        },
        "maximum_worker_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "stale_lock_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "blocked_spec_exit_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "inconclusive_exit_code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 255
        },
        "git_author_name": {
          "type": "string",
          "minLength": 1
        },
        "git_author_email": {
          "type": "string",
          "minLength": 1
        },
        "environment_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "protected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": { "const": "command" }
            }
          },
          "then": {
            "required": ["argv"],
            "properties": {
              "argv": { "minItems": 1 }
            }
          },
          "else": {
            "properties": {
              "argv": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": { "const": "copilot-sdk" }
            }
          },
          "then": {
            "required": [
              "sdk_runner",
              "sdk_version",
              "model",
              "required_specialist_roles",
              "honor_agent_models"
            ]
          }
        }
      ]
    }
  }
}
