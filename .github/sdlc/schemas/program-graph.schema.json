{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-graph.schema.json",
  "title": "GTS SDLC agent-authored program graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "changeId",
    "graphRevision",
    "requirementsDigest",
    "impactDigest",
    "planDigest",
    "repositories",
    "nodes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "changeId": { "$ref": "#/$defs/id" },
    "graphRevision": { "type": "integer", "minimum": 1 },
    "requirementsDigest": { "$ref": "#/$defs/digest" },
    "impactDigest": { "$ref": "#/$defs/digest" },
    "planDigest": { "$ref": "#/$defs/digest" },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repositoryId", "disposition", "baseRevision", "dependsOn", "sharedResources"],
        "properties": {
          "repositoryId": { "$ref": "#/$defs/id" },
          "disposition": { "enum": ["IMPLEMENTATION", "VALIDATION_ONLY", "CONTEXT_ONLY", "NOT_IMPACTED"] },
          "baseRevision": { "type": "string", "minLength": 1 },
          "worktree": { "type": "string", "minLength": 1 },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "sharedResources": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "dependsOn", "task", "attemptBudget", "evidenceTypes", "requirementIds", "planTaskIds"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": {
            "enum": ["REQUIREMENTS", "IMPACT", "PLAN", "PLAN_REVIEW", "HUMAN_GATE_1", "CHECKOUT", "IMPLEMENT", "VERIFY", "INTEGRATE", "CLOSURE", "PR_DRAFT", "HUMAN_GATE_2"]
          },
          "repositoryId": { "$ref": "#/$defs/id" },
          "dependsOn": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "task": { "type": "string", "minLength": 1 },
          "attemptBudget": { "type": "integer", "minimum": 1, "maximum": 10 },
          "evidenceTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "requirementIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "planTaskIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/id" }
          },
          "sharedResources": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
