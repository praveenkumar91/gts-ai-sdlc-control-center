{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program.schema.json",
  "title": "GTS SDLC program configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "programId",
    "catalogGlobs",
    "repositoryLocalDescriptor",
    "workspaceSearchRoots",
    "worktreeRoot",
    "runRoot",
    "auditRoot",
    "defaults",
    "protectedBranches",
    "automationIdentities"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "programId": { "$ref": "#/$defs/id" },
    "catalogGlobs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "repositoryLocalDescriptor": { "type": "string", "minLength": 1 },
    "workspaceSearchRoots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "worktreeRoot": { "type": "string", "minLength": 1 },
    "runRoot": { "type": "string", "minLength": 1 },
    "auditRoot": { "type": "string", "minLength": 1 },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "riskTier",
        "maxCatalogRepositories",
        "maxActiveRepositories",
        "maxParallelWorkers",
        "maxNodeAttempts",
        "maxPlanReviewCycles",
        "requireGate1",
        "requireGate2"
      ],
      "properties": {
        "riskTier": { "enum": ["low", "medium", "high", "critical"] },
        "maxCatalogRepositories": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxActiveRepositories": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxParallelWorkers": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxNodeAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "maxPlanReviewCycles": { "type": "integer", "minimum": 1, "maximum": 10 },
        "requireGate1": { "const": true },
        "requireGate2": { "const": true }
      }
    },
    "protectedBranches": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "automationIdentities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
