{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sdlc/artifact-envelope.schema.json",
  "title": "SDLC artifact envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "artifact_name",
    "producer",
    "decision",
    "commit_sha",
    "created_at",
    "payload_sha256",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "change_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "artifact_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*\\.json$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "PASS",
        "FAIL",
        "INCONCLUSIVE",
        "BLOCKED_SPEC"
      ]
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": {
      "type": "object"
    }
  }
}
