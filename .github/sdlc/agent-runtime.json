{
  "schema_version": "1.0",
  "adoption_complete": true,
  "worker": {
    "enabled": true,
    "mode": "copilot-sdk",
    "sdk_runner": ".github/scripts/copilot_runtime.py",
    "sdk_version": "1.0.7",
    "model": "auto",
    "required_specialist_roles": [
      "implementation",
      "build",
      "testing",
      "independent-domain-review"
    ],
    "honor_agent_models": true,
    "working_directory": "worktree",
    "timeout_seconds": 7200,
    "max_output_bytes": 2097152,
    "max_prompt_bytes": 200000,
    "maximum_worker_attempts": 3,
    "stale_lock_seconds": 900,
    "blocked_spec_exit_code": 20,
    "inconclusive_exit_code": 21,
    "git_author_name": "SDLC Repository Worker",
    "git_author_email": "sdlc-worker@example.invalid",
    "environment_allowlist": [
      "PATH",
      "PATHEXT",
      "SYSTEMROOT",
      "WINDIR",
      "COMSPEC",
      "TEMP",
      "TMP",
      "USERPROFILE",
      "HOME",
      "APPDATA",
      "LOCALAPPDATA",
      "LANG",
      "LC_ALL",
      "TERM"
    ],
    "protected_paths": [
      ".github/sdlc/project.json",
      ".github/sdlc/extensions.json",
      ".github/workflows/**",
      ".github/CODEOWNERS",
      "CODEOWNERS"
    ]
  }
}
